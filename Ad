local function SendNotification(msg, color)
    local lines = {}
    for line in NotifyLog.Text:gmatch("[^\n]+") do
        table.insert(lines, line)
    end
    while #lines >= 4 do
        table.remove(lines, 1)
    end
    table.insert(lines, "• " .. msg)
    NotifyLog.Text = table.concat(lines, "\n")
    if color then
        NotifyLog.TextColor3 = color
    end
end

local function IsPlayerAlive()
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    return true
end

-- ==========================================================
-- ✅ فحص اللوبي المحسّن - الطريقة الصحيحة
-- ==========================================================
local function IsInLobby()
    -- الطريقة 1: فحص عدد الكوينز في الماب
    local coinCount = 0
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin") then
            coinCount = coinCount + 1
        end
    end
    
    -- إذا كان عدد الكوينز أقل من 3، يعني في اللوبي
    if coinCount < 3 then
        return true
    end
    
    -- الطريقة 2: فحص وجود مجلد الماب
    local hasMap = false
    for _, child in pairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name ~= "Lobby" and child.Name ~= "Camera" and child ~= LocalPlayer.Character then
            -- تأكد انه فيه أجزاء كافية
            if #child:GetChildren() > 3 then
                hasMap = true
                break
            end
        end
    end
    
    if not hasMap then
        return true
    end
    
    -- الطريقة 3: فحص متغير الجولة (إن وجد)
    local roundActive = nil
    pcall(function()
        if ReplicatedStorage:FindFirstChild("RoundActive") then
            roundActive = ReplicatedStorage.RoundActive.Value
        end
    end)
    
    if roundActive == false then
        return true
    end
    
    -- إذا وصلنا هنا، يعني إحنا في الجولة
    return false
end

