-- ====== تهيئة القوائم ======
local function InitAds()
	AvailableAds = {}
	AdViewCount = {}
	
	for _, ad in ipairs(BaseAds) do
		table.insert(AvailableAds, ad)
		AdViewCount[ad.Id] = 0
	end
	
	for _, ad in ipairs(PublishedAds) do
		table.insert(AvailableAds, ad)
		AdViewCount[ad.Id] = 0
	end
	
	print("📢 تم تهيئة " .. #AvailableAds .. " إعلان")
end

-- ====== دالة عرض الإعلان ======
local function ShowAd(ad)
	if not ad then
		if #AvailableAds == 0 then
			print("🔄 جميع الإعلانات انتهت، إعادة التهيئة...")
			InitAds()
			if #AvailableAds == 0 then
				print("⚠️ لا يوجد إعلانات للعرض!")
				return
			end
		end
		local randomIndex = math.random(1, #AvailableAds)
		ad = AvailableAds[randomIndex]
	end
	
	print("📢 Showing: " .. ad.Type .. " - " .. ad.Id)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 420, 0, 250)
	frame.Position = UDim2.new(0.5, -210, 0.5, -125)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.BorderSizePixel = 0
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 170, 255)
	stroke.Thickness = 2
	stroke.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 30)
	title.BackgroundTransparency = 1
	title.Text = "📢 Advertisement"
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Parent = frame

	local viewCounter = Instance.new("TextLabel")
	viewCounter.Size = UDim2.new(0, 80, 0, 20)
	viewCounter.Position = UDim2.new(1, -85, 0, 5)
	viewCounter.BackgroundTransparency = 1
	viewCounter.Text = "👁 " .. (AdViewCount[ad.Id] or 0) + 1 .. "/" .. MAX_VIEWS
	viewCounter.Font = Enum.Font.Gotham
	viewCounter.TextScaled = true
	viewCounter.TextColor3 = Color3.fromRGB(200, 200, 200)
	viewCounter.Parent = frame

	if ad.Type == "Image" then
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(1, -10, 1, -45)
		img.Position = UDim2.new(0, 5, 0, 35)
		img.BackgroundTransparency = 1
		img.ScaleType = Enum.ScaleType.Fit
		img.Image = "https://www.roblox.com/asset-thumbnail/image?assetId=" .. ad.Id .. "&width=420&height=420"
		img.Parent = frame
		task.wait(0.5)
	else
		local video = Instance.new("VideoFrame")
		video.Size = UDim2.new(1, -10, 1, -45)
		video.Position = UDim2.new(0, 5, 0, 35)
		video.BackgroundTransparency = 1
		video.Video = "rbxassetid://" .. ad.Id
		video.Volume = 0
		video.Looped = true
		video.Parent = frame
		repeat task.wait(0.5) until video.IsLoaded == true
		video:Play()
	end

	AdViewCount[ad.Id] = (AdViewCount[ad.Id] or 0) + 1

	if AdViewCount[ad.Id] >= MAX_VIEWS then
		for i = #AvailableAds, 1, -1 do
			if AvailableAds[i].Id == ad.Id then
				table.remove(AvailableAds, i)
				print("🗑️ تم حذف الإعلان " .. ad.Id .. " بعد " .. MAX_VIEWS .. " مشاهدة")
				break
			end
		end
	end

	task.wait(AD_DURATION)
	frame:Destroy()
end

-- ====== دالة نشر إعلان جديد (للمصرح له فقط) ======
local function PublishAd(assetId, adType)
	if not isPublisher then
		print("🚫 غير مصرح لك بالنشر!")
		return
	end
	
	if assetId == "" then
		statusLabel.Text = "⚠️ أدخل Asset ID!"
		return
	end
	
	if not tonumber(assetId) then
		statusLabel.Text = "⚠️ أدخل أرقام فقط!"
		return
	end
	
	for _, ad in ipairs(PublishedAds) do
		if ad.Id == assetId then
			statusLabel.Text = "⚠️ هذا الإعلان موجود مسبقاً!"
			return
		end
	end
	
	local newAd = {Type=adType or "Image", Id=assetId}
	table.insert(PublishedAds, newAd)
	table.insert(AvailableAds, newAd)
	AdViewCount[assetId] = 0
	
	statusLabel.Text = "✅ نشر: " .. assetId
	print("📢 تم نشر الإعلان: " .. assetId .. " بواسطة " .. PUBLISHER_NAME)
	
	task.spawn(function()
		task.wait(PUBLISHED_DURATION)
		for i = #PublishedAds, 1, -1 do
			if PublishedAds[i].Id == assetId then
				table.remove(PublishedAds, i)
			end
		end
		for i = #AvailableAds, 1, -1 do
			if AvailableAds[i].Id == assetId then
				table.remove(AvailableAds, i)
			end
		end
		print("⏰ انتهت صلاحية الإعلان المنشور: " .. assetId)
		UpdateCounter()
	end)
	
	ShowAd(newAd)
	UpdatePublishedList()
	UpdateCounter()
end

-- ====== دالة حذف إعلان منشور (للمصرح له فقط) ======
local function DeletePublishedAd(assetId)
	if not isPublisher then
		print("🚫 غير مصرح لك بالحذف!")
		return
	end
	
	for i = #PublishedAds, 1, -1 do
		if PublishedAds[i].Id == assetId then
			table.remove(PublishedAds, i)
			print("🗑️ تم حذف الإعلان المنشور: " .. assetId)
		end
	end
	for i = #AvailableAds, 1, -1 do
		if AvailableAds[i].Id == assetId then
			table.remove(AvailableAds, i)
		end
	end
	UpdatePublishedList()
	UpdateCounter()
end

