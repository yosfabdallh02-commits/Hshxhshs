-- وظيفة الإرسال
SendBtn.MouseButton1Click:Connect(function()
    local key = KeyBox.Text
    local msg = MsgBox.Text
    
    if msg == "" then
        SendBtn.Text = "⚠️ Write message!"
        task.wait(1.5)
        SendBtn.Text = "Send Message 🚀"
        return
    end
    
    if key == "" then
        SendBtn.Text = "⚠️ Write key!"
        task.wait(1.5)
        SendBtn.Text = "Send Message 🚀"
        return
    end
    
    SendBtn.Text = "⏳ Sending..."
    SendBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
    
    local request = (syn and syn.request)
        or (http and http.request)
        or http_request
        or request
    
    local success, err = pcall(function()
        request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = game:GetService("HttpService"):JSONEncode({
                ["content"] = "@everyone",
                ["username"] = "AMT",
                ["embeds"] = {{
                    ["title"] = key, -- المفتاح كعنوان
                    ["description"] = msg,
                    ["color"] = 16777215, -- أبيض
                    ["footer"] = {
                        ["text"] = "Sent by AMT"
                    }
                }}
            })
        })
    end)
    
    if success then
        SendBtn.Text = "✅ Sent!"
        SendBtn.BackgroundColor3 = Color3.fromRGB(100, 220, 100)
        KeyBox.Text = ""
        MsgBox.Text = ""
    else
        SendBtn.Text = "❌ Failed!"
        SendBtn.BackgroundColor3 = Color3.fromRGB(220, 100, 100)
        print("Error:", err)
    end
    
    task.wait(2)
    SendBtn.Text = "Send Message 🚀"
    SendBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
end)

-- جعل الواجهة قابلة للسحب
local dragging = false
local dragStart, startPos

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
    end
end)

Frame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

Frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

