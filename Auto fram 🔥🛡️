local function SendNotification(msg, color)
    local oldText = NotifyLog.Text
    local lines = {}
    for line in oldText:gmatch("[^\n]+") do
        table.insert(lines, line)
    end
    -- Keep last 4 lines
    while #lines >= 4 do
        table.remove(lines, 1)
    end
    table.insert(lines, "• " .. msg)
    NotifyLog.Text = table.concat(lines, "\n")
    if color then
        NotifyLog.TextColor3 = color
    end
end

local function IsPlayerAlive()
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    return true
end

-- 🧠 الفحص المتطور: يعتمد على 3 طرق للكشف عن بداية الجولة
local function IsInLobby()
    -- الطريقة 1: فحص عدد الكوينز في الماب
    local coinCount = 0
    local mapParts = 0
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            -- عد الكوينز
            if v.Name == "Coin_Server" or v.Name == "Coin" then
                coinCount = coinCount + 1
            end
            -- عد أجزاء الماب (أي أجزاء غير لاعبين وإضاءة)
            if v.Parent and v.Parent ~= LocalPlayer.Character and v.Parent.Name ~= "Lighting" and v.Parent.Name ~= "Camera" then
                mapParts = mapParts + 1
            end
        end
    end
    
    -- الطريقة 2: فحص وجود مجلد الماب في Workspace
    local hasMap = false
    for _, child in pairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name ~= "Lobby" and child.Name ~= "Camera" and child.Name ~= "Lighting" then
            -- تأكد انه مو شخصية اللاعب
            if child ~= LocalPlayer.Character then
                hasMap = true
                break
            end
        end
    end
    
    -- الطريقة 3: فحص متغير الجولة من ReplicatedStorage (إن وجد)
    local roundActive = nil
    pcall(function()
        if ReplicatedStorage:FindFirstChild("RoundActive") then
            roundActive = ReplicatedStorage.RoundActive.Value
        end
    end)
    
    -- ✅ القرار النهائي: إحنا باللوبي إذا:
    -- 1- مافي كوينز كافية (اقل من 3)
    -- 2- مافي ماب محمل
    -- 3- أو roundActive == false (إذا كان موجود)
    
    if coinCount < 3 then
        return true -- ما فيه كوينز كافية = لوبي
    end
    
    if not hasMap then
        return true -- ما فيه ماب = لوبي
    end
    
    if roundActive == false then
        return true -- الجولة منتهية رسمياً = لوبي
    end
    
    return false -- كل شيء تمام = في الجولة
end

