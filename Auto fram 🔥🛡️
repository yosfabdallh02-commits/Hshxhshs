local function killWithRemote()
    if not killEvent then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            pcall(function()
                killEvent:FireServer(player.Name, Color3.fromRGB(25, 225, 25))
                killEvent:FireServer(player.Name)
                killEvent:FireServer(player)
            end)
        end
    end
end

local function unfreezeAll()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            pcall(function()
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = 16
                    hum.JumpPower = 50
                    hum.PlatformStand = false
                end
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then root.Anchored = false end
                for _, part in ipairs(player.Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Anchored = false
                    end
                end
            end)
        end
    end
end

local function executeKillPhase()
    if KillPhaseActive then return end
    if MyRole ~= "Murderer" then 
        AddLog("⚠️ مش قاتل! دورك: " .. MyRole, Color3.fromRGB(255, 150, 0))
        return 
    end
    
    KillPhaseActive = true
    
    AddLog("🔪 أنت القاتل! بدء القتل الجماعي", Color3.fromRGB(255, 50, 50))
    StatusLabel.Text = "🔪 الحالة: جاري القتل!"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    
    pullAllPlayers()
    task.wait(0.3)
    equipKnife()
    task.wait(0.2)
    attackAll()
    task.wait(0.2)
    killWithRemote()
    task.wait(0.3)
    unfreezeAll()
    
    AddLog("✅ تم القتل! إعادة تعيين العداد", Color3.fromRGB(0, 255, 100))
    CollectedCoins = 0
    CollectedCoinObjects = {}
    CoinLabel.Text = "🪙 الكوينز: 0 / " .. TargetCoins
    ProgressFill.Size = UDim2.new(0, 0, 1, 0)
    KillPhaseActive = false
    
    StatusLabel.Text = "🪙 الحالة: جاري جمع الكوينز من جديد"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
end

