local function animateRedDots()
    local screenWidth = AFKScreen.AbsoluteSize.X
    local screenHeight = AFKScreen.AbsoluteSize.Y
    local positions = {
        UDim2.new(0, 0, 0, 0), -- أعلى اليسار
        UDim2.new(1, -20, 0, 0), -- أعلى اليمين
        UDim2.new(1, -20, 1, -20), -- أسفل اليمين
        UDim2.new(0, 0, 1, -20) -- أسفل اليسار
    }
    for i, dot in ipairs(redDots) do
        local nextIndex = i % 4 + 1
        TweenService:Create(dot, TweenInfo.new(1.5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), {Position = positions[nextIndex]}):Play()
        task.wait(0.3)
    end
end

AFKScreen:GetPropertyChangedSignal("Visible"):Connect(function()
    if AFKScreen.Visible then
        animateRedDots()
    else
        for _, dot in ipairs(redDots) do
            TweenService:Create(dot, TweenInfo.new(0.5), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        end
    end
end)

