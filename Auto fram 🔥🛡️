local function GetNearestValidCoin(rootPos)
    local nearest = nil
    local shortestDist = math.huge
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin") and not CollectedCoins[v] then
            local dist = (v.Position - rootPos).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearest = v
            end
        end
    end
    return nearest
end

task.spawn(function()
    while true do
        task.wait(0.2)
        
        if AutoCoin then
            if not IsPlayerAlive() then
                StatusLabel.Text = "💀 الحالة: ميت / بانتظار الترسبن"
                if CurrentTween then CurrentTween:Cancel() end
                Platform.CFrame = CFrame.new(0, 99999, 0)
                task.wait(1)
                continue
            end
            
            -- 🛑 الفحص الحاسم: لو كنا باللوبي، قف مكانك
            if IsInLobby() then
                StatusLabel.Text = "🏠 الحالة: في اللوبي (متوقف تماماً)"
                if CurrentTween then
                    CurrentTween:Cancel()
                    CurrentTween = nil
                end
                Platform.CFrame = CFrame.new(0, 99999, 0)
                task.wait(1)
                continue
            end
            
            local Character = LocalPlayer.Character
            local Root = Character and Character:FindFirstChild("HumanoidRootPart")
            
            if Character and Root then
                local TargetCoin = GetNearestValidCoin(Root.Position)
                
                if TargetCoin and TargetCoin.Parent then
                    StatusLabel.Text = "🪙 الحالة: داخل الماب - جاري التجميع"
                    SendNotification("🎯 جاري التجميع من الماب...", Color3.fromRGB(100, 200, 255))
                    
                    local TargetUnderPos = Vector3.new(TargetCoin.Position.X, TargetCoin.Position.Y - UnderGroundDepth, TargetCoin.Position.Z)
                    Platform.CFrame = CFrame.new(TargetUnderPos.X, TargetUnderPos.Y - 2.5, TargetUnderPos.Z)
                    
                    local Distance = (Root.Position - TargetUnderPos).Magnitude
                    local TweenTime = math.max(Distance / 25, 0.2) -- سرعة ذكية
                    local TInfo = TweenInfo.new(TweenTime, Enum.EasingStyle.Linear)
                    
                    CurrentTween = TweenService:Create(Root, TInfo, {CFrame = CFrame.new(TargetUnderPos)})
                    CurrentTween:Play()
                    
                    while CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing do
                        task.wait(0.05)
                        if not AutoCoin or not IsPlayerAlive() or IsInLobby() then
                            if CurrentTween then CurrentTween:Cancel() end
                            break
                        end
                    end
                    
                    if AutoCoin and IsPlayerAlive() and not IsInLobby() and TargetCoin and TargetCoin.Parent then
                        StatusLabel.Text = "⚡ طلوع ونزول آمن"
                        local undergroundCFrame = Root.CFrame
                        local CoinPos = TargetCoin.CFrame
                        
                        local UpTweenTime = 0.25
                        local UpTInfo = TweenInfo.new(UpTweenTime, Enum.EasingStyle.Linear)
                        local UpTween = TweenService:Create(Root, UpTInfo, {CFrame = CoinPos})
                        UpTween:Play()
                        task.wait(UpTweenTime)
                        
                        pcall(function()
                            firetouchinterest(Root, TargetCoin, 0)
                            firetouchinterest(Root, TargetCoin, 1)
                        end)
                        
                        CollectedCoins[TargetCoin] = true
                        SendNotification("✅ تم لقط الكوين!", Color3.fromRGB(0, 255, 100))
                        task.wait(0.05)
                        
                        local DownTween = TweenService:Create(Root, UpTInfo, {CFrame = undergroundCFrame})
                        DownTween:Play()
                        task.wait(UpTweenTime)
                    end
                else
                    StatusLabel.Text = "🔍 بانتظار كوينز جديدة..."
                    CollectedCoins = {}
                    task.wait(0.5)
                end
            end
        end
    end
end) 
 
