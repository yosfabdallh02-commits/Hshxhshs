local function UpdateRoleESP()
    ClearRoleList()
    if RoleData[LocalPlayer.Name] then
        MyRole = RoleData[LocalPlayer.Name].Role
        if MyRole == "Murderer" then
            RoleLabel.Text = "🎭 دوري: 🔪 القاتل"
            RoleLabel.TextColor3 = Coral
        elseif MyRole == "Sheriff" then
            RoleLabel.Text = "🎭 دوري: 🔫 الشريف"
            RoleLabel.TextColor3 = SkyBlue
        else
            RoleLabel.Text = "🎭 دوري: 👤 بريء"
            RoleLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        end
    end
    local rows = {}
    for name, info in pairs(RoleData) do
        if info.Role == "Murderer" or info.Role == "Sheriff" then
            table.insert(rows, {name = name, role = info.Role})
        end
    end
    if #rows == 0 then
        RoleESP_Frame.Visible = false
        return
    end
    RoleESP_Frame.Visible = true
    for _, entry in ipairs(rows) do
        local isMurderer = entry.role == "Murderer"
        local col = isMurderer and Coral or SkyBlue
        local ico = isMurderer and "🔪" or "🔫"
        local isMe = entry.name == LocalPlayer.Name
        local row = Instance.new("Frame", RoleList)
        row.Size = UDim2.new(1, -6, 0, 26)
        row.BackgroundColor3 = isMe and Color3.fromRGB(25, 25, 35) or Color3.fromRGB(18, 18, 28)
        row.BackgroundTransparency = 1
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        local nameLabel = Instance.new("TextLabel", row)
        nameLabel.Size = UDim2.new(1, -50, 1, 0)
        nameLabel.Position = UDim2.new(0, 8, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = ico .. " " .. entry.name .. (isMe and " ◀" or "")
        nameLabel.TextColor3 = isMe and WhiteSand or Color3.fromRGB(200, 200, 200)
        nameLabel.TextSize = 10
        nameLabel.Font = isMe and Enum.Font.GothamBold or Enum.Font.Gotham
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        local roleLabel = Instance.new("TextLabel", row)
        roleLabel.Size = UDim2.new(0, 40, 1, 0)
        roleLabel.Position = UDim2.new(1, -42, 0, 0)
        roleLabel.BackgroundTransparency = 1
        roleLabel.Text = isMurderer and "قاتل" or "شريف"
        roleLabel.TextColor3 = col
        roleLabel.TextSize = 9
        roleLabel.Font = Enum.Font.GothamBold
        roleLabel.TextXAlignment = Enum.TextXAlignment.Right
    end
    RoleESP_Frame.Size = UDim2.new(0, 200, 0, 28 + #rows * 28 + 6)
end

local function ClearRoleData()
    RoleData = {}
    MyRole = "Unknown"
    RoleLabel.Text = "🎭 دوري: غير معروف"
    RoleLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    ClearRoleList()
    RoleESP_Frame.Visible = false
end

