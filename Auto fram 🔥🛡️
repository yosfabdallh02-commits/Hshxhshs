local function UpdateRoleESP()
    ClearRoleList()
    
    if RoleData[LocalPlayer.Name] then
        MyRole = RoleData[LocalPlayer.Name].Role
        if MyRole == "Murderer" then
            RoleLabel.Text = "🎭 دوري: 🔪 القاتل"
            RoleLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        elseif MyRole == "Sheriff" then
            RoleLabel.Text = "🎭 دوري: 🔫 الشريف"
            RoleLabel.TextColor3 = Color3.fromRGB(60, 100, 255)
        else
            RoleLabel.Text = "🎭 دوري: 👤 بريء"
            RoleLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    end
    
    local rows = {}
    for name, info in pairs(RoleData) do
        if info.Role == "Murderer" or info.Role == "Sheriff" then
            table.insert(rows, {name = name, role = info.Role})
        end
    end
    
    if #rows == 0 then
        RoleESP_Frame.Visible = false
        return
    end
    
    RoleESP_Frame.Visible = true
    
    for _, entry in ipairs(rows) do
        local isMurderer = entry.role == "Murderer"
        local col = isMurderer and Color3.fromRGB(220, 45, 45) or Color3.fromRGB(60, 100, 255)
        local ico = isMurderer and "🔪" or "🔫"
        local isMe = entry.name == LocalPlayer.Name
        
        local row = Instance.new("Frame", RoleList)
        row.Size = UDim2.new(1, -6, 0, 30)
        row.BackgroundColor3 = isMe and Color3.fromRGB(20, 20, 50) or Color3.fromRGB(14, 14, 28)
