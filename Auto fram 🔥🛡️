local function UpdateRoleESP()
    ClearRoleList()
    
    -- تحديث دوري من البيانات المخزنة
    if RoleData[LocalPlayer.Name] then
        MyRole = RoleData[LocalPlayer.Name].Role
        if MyRole == "Murderer" then
            RoleLabel.Text = "🎭 دوري: 🔪 القاتل"
            RoleLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        elseif MyRole == "Sheriff" then
            RoleLabel.Text = "🎭 دوري: 🔫 الشريف"
            RoleLabel.TextColor3 = Color3.fromRGB(60, 100, 255)
        else
            RoleLabel.Text = "🎭 دوري: 👤 بريء"
            RoleLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    end
    
    -- بناء القائمة
    local rows = {}
    for name, info in pairs(RoleData) do
        if info.Role == "Murderer" or info.Role == "Sheriff" then
            table.insert(rows, {name = name, role = info.Role})
        end
    end
    
    if #rows == 0 then
        RoleESP_Frame.Visible = false
        return
    end
    
    RoleESP_Frame.Visible = true
    
    -- ترتيب: القاتل أول
    table.sort(rows, function(a, b)
        if a.role == "Murderer" then return true end
        if b.role == "Murderer" then return false end
        return a.name < b.name
    end)
    
    for _, entry in ipairs(rows) do
        local isMurderer = entry.role == "Murderer"
        local col = isMurderer and Color3.fromRGB(220, 45, 45) or Color3.fromRGB(60, 100, 255)
        local ico = isMurderer and "🔪" or "🔫"
        local isMe = entry.name == LocalPlayer.Name
        
        local row = Instance.new("Frame", RoleList)
        row.Size = UDim2.new(1, -6, 0, 30)
        row.BackgroundColor3 = isMe and Color3.fromRGB(20, 20, 50) or Color3.fromRGB(14, 14, 28)
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        
        if isMe then
            local rs = Instance.new("UIStroke", row)
            rs.Color = col
            rs.Thickness = 1
        end
        
        local bar = Instance.new("Frame", row)
        bar.Size = UDim2.new(0, 3, 0.7, 0)
        bar.Position = UDim2.new(0, 0, 0.15, 0)
        bar.BackgroundColor3 = col
        
        local icoLabel = Instance.new("TextLabel", row)
        icoLabel.Size = UDim2.new(0, 20, 1, 0)
        icoLabel.Position = UDim2.new(0, 6, 0, 0)
        icoLabel.BackgroundTransparency = 1
        icoLabel.Text = ico
        icoLabel.TextSize = 14
        
        local nameLabel = Instance.new("TextLabel", row)
        nameLabel.Size = UDim2.new(1, -80, 1, 0)
        nameLabel.Position = UDim2.new(0, 28, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = isMe and (entry.name .. " ◀") or entry.name
        nameLabel.TextColor3 = isMe and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        nameLabel.TextSize = 11
        nameLabel.Font = isMe and Enum.Font.GothamBold or Enum.Font.Gotham
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        
        local roleLabel = Instance.new("TextLabel", row)
        roleLabel.Size = UDim2.new(0, 50, 1, 0)
        roleLabel.Position = UDim2.new(1, -52, 0, 0)
        roleLabel.BackgroundTransparency = 1
        roleLabel.Text = isMurderer and "قاتل" or "شريف"
        roleLabel.TextColor3 = col
        roleLabel.TextSize = 10
        roleLabel.Font = Enum.Font.GothamBold
        roleLabel.TextXAlignment = Enum.TextXAlignment.Right
    end
    
    RoleESP_Frame.Size = UDim2.new(0, 220, 0, 30 + #rows * 32 + 6)
end

