            if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
            Platform.CFrame = CFrame.new(0, 99999, 0)
            unfreezeAll()
            SaveAccumulatedTime()
        end
    elseif input.KeyCode == Enum.KeyCode.F3 then
        AFKMode = not AFKMode
        if AFKMode then
            AFKScreen.Visible = true
            AFKBtn.Text = "💤 إغلاق AFK"
            AFKBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        else
            AFKScreen.Visible = false
            AFKBtn.Text = "💤 تفعيل AFK"
            AFKBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 210)
        end
    end
end)

