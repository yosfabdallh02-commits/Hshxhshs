function AddLog(msg, color)
    local lines = {}
    for line in LogText.Text:gmatch("[^\n]+") do
        table.insert(lines, line)
    end
    while #lines >= 4 do
        table.remove(lines, 1)
    end
    table.insert(lines, "• " .. msg)
    LogText.Text = table.concat(lines, "\n")
    if color then LogText.TextColor3 = color end
end

local function IsPlayerAlive()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function IsInRound()
    local coinCount = 0
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin") then
            coinCount = coinCount + 1
        end
    end
    if coinCount < 3 then return false end
    
    local hasMap = false
    for _, child in pairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name ~= "Lobby" and child.Name ~= "Camera" and child ~= LocalPlayer.Character then
            if #child:GetChildren() > 3 then
                hasMap = true
                break
            end
        end
    end
    
    return hasMap
end

local function GetNearestCoin(rootPos)
    local nearest = nil
    local shortestDist = math.huge
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin") and not CollectedCoinObjects[v] then
            local dist = (v.Position - rootPos).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearest = v
            end
        end
    end
    return nearest
end

