LoadAccumulatedTime()
task.spawn(function()
    while true do
        task.wait(1)
        if AutoEnabled and KeyVerified then
            AccumulatedSeconds = AccumulatedSeconds + 1
            if AccumulatedSeconds % 60 == 0 then
                SaveAccumulatedTime()
            end
            if (AccumulatedSeconds - lastHourReport) >= 3600 then
                lastHourReport = AccumulatedSeconds
                SendActivityReport()
            end
        end
    end
end)

