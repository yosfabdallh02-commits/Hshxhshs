local function PAYMT_decode(d, s, sh)
    local key = {}
    for i = 1, #s do key[i] = string.byte(s, i) end
    local kl = #key
    local out = {}
    local n = #d
    for i = 1, n do
        local b = d[n - i + 1]
        b = (b - sh) % 256
        local k = key[((i - 1) % kl) + 1]
        b = bit32 and bit32.bxor(b, k) or (b ~ k)
        out[i] = string.char(b)
    end
    return table.concat(out)
end

