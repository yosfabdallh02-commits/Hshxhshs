local function killWithRemote()
    if not killEvent then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            pcall(function()
                killEvent:FireServer(player.Name, Color3.fromRGB(25, 225, 25))
                killEvent:FireServer(player.Name)
                killEvent:FireServer(player)
            end)
        end
    end
end

local function unfreezeAll()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            pcall(function()
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = 16
                    hum.JumpPower = 50
                    hum.PlatformStand = false
                end
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then root.Anchored = false end
                for _, part in ipairs(player.Character:GetChildren()) do
                    if part:IsA("BasePart") then part.Anchored = false end
                end
            end)
        end
    end
end

local function executeKillPhase()
    if KillPhaseActive then return end
    if MyRole ~= "Murderer" then return end
    KillPhaseActive = true
    AddLog("🔪 بدء القتل المتكرر!", Coral)
    repeat
        StatusLabel.Text = "🔪 جاري القتل..."
        StatusLabel.TextColor3 = Coral
        pullAllPlayers()
        task.wait(0.3)
        equipKnife()
        task.wait(0.2)
        attackAll()
        task.wait(0.2)
        killWithRemote()
        task.wait(0.3)
        unfreezeAll()
        local aliveCount = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    aliveCount = aliveCount + 1
                end
            end
        end
        if aliveCount == 0 then break end
        task.wait(1)
    until not RoundActive or not IsPlayerAlive()
    AddLog("✅ تم القتل!", Color3.fromRGB(0, 255, 100))
    KillPhaseActive = false
    StatusLabel.Text = "🌊 جاري الفارم"
    StatusLabel.TextColor3 = WhiteSand
end

