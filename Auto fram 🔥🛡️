-- 🔄 الدورة الرئيسية للفارم
-- ==========================================================
local function farmLoop()
    while AutoEnabled do
        task.wait(0.1)
        
        if not IsPlayerAlive() then
            StatusLabel.Text = "💀 الحالة: ميت - بانتظار الترسبن"
            if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
            Platform.CFrame = CFrame.new(0, 99999, 0)
            task.wait(1)
            continue
        end
        
        if not IsInRound() then
            StatusLabel.Text = "🏠 الحالة: في اللوبي - بانتظار الجولة"
            if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
            Platform.CFrame = CFrame.new(0, 99999, 0)
            RoundActive = false
            CollectedCoins = 0
            CollectedCoinObjects = {}
            CoinLabel.Text = "🪙 الكوينز: 0 / " .. TargetCoins
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
            task.wait(1)
            continue
        end
        
        RoundActive = true
        
        -- إذا وصلنا لـ 50 عملة وكنت القاتل → اذبح الكل
        if CollectedCoins >= TargetCoins and not KillPhaseActive and MyRole == "Murderer" then
            executeKillPhase()
            continue
        end
        
        -- إذا وصلت لـ 50 عملة ومش قاتل → استمر في الجمع
        if CollectedCoins >= TargetCoins and MyRole ~= "Murderer" and MyRole ~= "Unknown" then
            AddLog("✅ 50 كوين! مستمر بالتجميع (دورك: " .. MyRole .. ")", Color3.fromRGB(100, 255, 100))
            CollectedCoins = 0
            CollectedCoinObjects = {}
            CoinLabel.Text = "🪙 الكوينز: 0 / " .. TargetCoins
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
        end
        
        -- طور جمع الكوينز
        if not KillPhaseActive then
            StatusLabel.Text = "🪙 الحالة: جاري جمع الكوينز (" .. CollectedCoins .. "/" .. TargetCoins .. ")"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
            
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if char and root then
                local targetCoin = GetNearestCoin(root.Position)
                
                if targetCoin and targetCoin.Parent then
                    local targetUnder = Vector3.new(targetCoin.Position.X, targetCoin.Position.Y - UnderGroundDepth, targetCoin.Position.Z)
                    Platform.CFrame = CFrame.new(targetUnder.X, targetUnder.Y - 2.5, targetUnder.Z)
                    
                    local dist = (root.Position - targetUnder).Magnitude
                    local speed = tonumber(SpeedBox.Text) or 35
                    if speed < 5 then speed = 5 end
                    if speed > 100 then speed = 100 end
                    local tweenTime = dist / speed
                    
                    CurrentTween = TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetUnder)})
                    CurrentTween:Play()
                    
                    while CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing do
                        task.wait()
                        if not AutoEnabled or not IsPlayerAlive() or not IsInRound() then
                            if CurrentTween then CurrentTween:Cancel() end
                            break
                        end
                    end
                    
                    if AutoEnabled and IsPlayerAlive() and IsInRound() and targetCoin and targetCoin.Parent then
                        local undergroundCF = root.CFrame
                        local upTween = TweenService:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {CFrame = targetCoin.CFrame})
                        upTween:Play()
                        task.wait(0.25)
                        
                        pcall(function()
                            firetouchinterest(root, targetCoin, 0)
                            firetouchinterest(root, targetCoin, 1)
                        end)
                        
                        CollectedCoins = CollectedCoins + 1
                        CollectedCoinObjects[targetCoin] = true
                        CoinLabel.Text = "🪙 الكوينز: " .. CollectedCoins .. " / " .. TargetCoins
                        ProgressFill.Size = UDim2.new(CollectedCoins / TargetCoins, 0, 1, 0)
                        AddLog("🪙 تم جمع كوين! (" .. CollectedCoins .. "/" .. TargetCoins .. ")", Color3.fromRGB(255, 255, 0))
                        
                        local downTween = TweenService:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {CFrame = undergroundCF})
                        downTween:Play()
                        task.wait(0.25)
                    end
                else
                    CollectedCoinObjects = {}
                    task.wait(0.5)
                end
            end
        end
    end
end

