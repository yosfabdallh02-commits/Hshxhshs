local function pullAllPlayers()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = root.Position
    local lookVector = root.CFrame.LookVector
    local rightVector = root.CFrame.RightVector
    local players = Players:GetPlayers()
    local index = 0
    for _, player in ipairs(players) do
        if player ~= LocalPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local row = math.floor(index / 4)
                local col = index % 4
                local offsetX = (col - 1.5) * 1.2
                local offsetZ = row * 1.2 + 2
                local targetPos = pos + (lookVector * offsetZ) + (rightVector * offsetX)
                pcall(function()
                    targetRoot.CFrame = CFrame.new(targetPos, pos)
                    targetRoot.Anchored = true
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 0
                        hum.JumpPower = 0
                        hum.PlatformStand = true
                    end
                    for _, part in ipairs(player.Character:GetChildren()) do
                        if part:IsA("BasePart") then part.Anchored = true end
                    end
                end)
                index = index + 1
            end
        end
    end
end

