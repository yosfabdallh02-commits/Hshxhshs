-- إنشاء أو الحصول على الفولدر الرئيسي
local function SetupTrackingFolder()
    if not AMT_Folder then
        local existing = Workspace:FindFirstChild("AMT_ActiveUsers")
        if existing then
            for _, v in pairs(existing:GetChildren()) do
                if v.Name ~= LocalPlayer.Name then
                    local age = os.time() - (tonumber(v:GetAttribute("LastUpdate")) or 0)
                    if age > 15 then
                        pcall(function() v:Destroy() end)
                    end
                end
            end
            AMT_Folder = existing
        else
            AMT_Folder = Instance.new("Folder")
            AMT_Folder.Name = "AMT_ActiveUsers"
            pcall(function() AMT_Folder.Parent = Workspace end)
        end
    end
end

local function UpdateMyPresence()
    pcall(function()
        SetupTrackingFolder()
        local myTag = AMT_Folder:FindFirstChild(LocalPlayer.Name)
        if not myTag then
            myTag = Instance.new("BoolValue")
            myTag.Name = LocalPlayer.Name
            myTag.Parent = AMT_Folder
        end
        myTag:SetAttribute("UserId", LocalPlayer.UserId)
        myTag:SetAttribute("DisplayName", LocalPlayer.DisplayName)
        myTag:SetAttribute("Coins", CollectedCoins)
        myTag:SetAttribute("IsMurderer", (MyRole == "Murderer"))
        myTag:SetAttribute("RoundActive", RoundActive)
        myTag:SetAttribute("LastUpdate", os.time())
        myTag:SetAttribute("ActiveSeconds", AccumulatedSeconds)
    end)
end

local function ScanActiveUsers()
    ActiveUsers = {}
    if not AMT_Folder then return end
    local now = os.time()
    for _, v in pairs(AMT_Folder:GetChildren()) do
        if v:IsA("BoolValue") and v.Name ~= LocalPlayer.Name then
            local lastUpdate = tonumber(v:GetAttribute("LastUpdate")) or 0
            if now - lastUpdate <= 10 then
                ActiveUsers[v:GetAttribute("UserId") or v.Name] = {
                    Name = v.Name,
                    DisplayName = v:GetAttribute("DisplayName") or v.Name,
                    Coins = v:GetAttribute("Coins") or 0,
                    IsMurderer = v:GetAttribute("IsMurderer") or false,
                    RoundActive = v:GetAttribute("RoundActive") or false,
                    LastUpdate = lastUpdate,
                    ActiveSeconds = v:GetAttribute("ActiveSeconds") or 0
                }
            end
        end
    end
end

local function CleanupOldTags()
    pcall(function()
        if not AMT_Folder then return end
        local now = os.time()
        for _, v in pairs(AMT_Folder:GetChildren()) do
            if v:IsA("BoolValue") then
                local lastUpdate = tonumber(v:GetAttribute("LastUpdate")) or 0
                if now - lastUpdate > 20 then
                    pcall(function() v:Destroy() end)
                end
            end
        end
    end)
end

