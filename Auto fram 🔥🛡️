-- متغيرات لتخزين دور القاتل ومعلومات إضافية
local MurdererData = nil
local SheriffData = nil

local function BuildRoleList(data)
    ClearRoleList()
    MurdererData = nil
    SheriffData = nil
    
    -- البحث عن القاتل والشريف فقط
    for name, info in pairs(data) do
        if info.Role == "Murderer" then
            MurdererData = {name = name, info = info}
        elseif info.Role == "Sheriff" then
            SheriffData = {name = name, info = info}
        end
    end
    
    local rows = {}
    if MurdererData then table.insert(rows, MurdererData) end
    if SheriffData then table.insert(rows, SheriffData) end
    
    if #rows == 0 then
        RoleESP_Frame.Visible = false
        return
    end
    
    RoleESP_Frame.Visible = true
    
    for _, entry in ipairs(rows) do
        local name = entry.name
        local info = entry.info
        local col = entry == MurdererData and Color3.fromRGB(220, 45, 45) or Color3.fromRGB(60, 100, 255)
        local ico = entry == MurdererData and "🔪" or "🔫"
        local isMe = name == LocalPlayer.Name
        local isMurderer = entry == MurdererData
        
        local row = Instance.new("Frame", RoleList)
        row.Size = UDim2.new(1, -6, 0, 32)
        row.BackgroundColor3 = isMe and Color3.fromRGB(20,20,50) or Color3.fromRGB(14,14,28)
        row.BorderSizePixel = 0
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        if isMe then
            local rs = Instance.new("UIStroke", row)
            rs.Color = col
            rs.Thickness = 1
        end
        
        -- شريط جانبي
        local bar = Instance.new("Frame", row)
        bar.Size = UDim2.new(0, 3, 0.7, 0)
        bar.Position = UDim2.new(0, 0, 0.15, 0)
        bar.BackgroundColor3 = col
        bar.BorderSizePixel = 0
        Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 2)
        
        -- أيقونة الدور
        local icoL = Instance.new("TextLabel", row)
        icoL.Size = UDim2.new(0, 24, 1, 0)
        icoL.Position = UDim2.new(0, 6, 0, 0)
        icoL.BackgroundTransparency = 1
        icoL.Text = ico
        icoL.TextSize = 16
        icoL.Font = Enum.Font.GothamBold
        
        -- اسم اللاعب
        local nameL = Instance.new("TextLabel", row)
        nameL.Size = UDim2.new(1, -100, 1, 0)
        nameL.Position = UDim2.new(0, 32, 0, 0)
        nameL.BackgroundTransparency = 1
        nameL.Text = isMe and (name .. " ◀") or name
        nameL.TextColor3 = isMe and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200,200,200)
        nameL.TextSize = 11
        nameL.Font = isMe and Enum.Font.GothamBold or Enum.Font.Gotham
        nameL.TextXAlignment = Enum.TextXAlignment.Left
        nameL.TextTruncate = Enum.TextTruncate.AtEnd
        
        -- الدور + معلومات إضافية للقاتل
        local roleL = Instance.new("TextLabel", row)
        roleL.Size = UDim2.new(0, 72, 1, 0)
        roleL.Position = UDim2.new(1, -74, 0, 0)
        roleL.BackgroundTransparency = 1
        roleL.TextSize = 10
        roleL.Font = Enum.Font.GothamBold
        roleL.TextXAlignment = Enum.TextXAlignment.Right
        
        if isMurderer then
            -- معلومات إضافية للقاتل: عدد اللاعبين المتبقيين وحالة التخفي
            local alivePlayers = 0
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    alivePlayers = alivePlayers + 1
                end
            end
            local isHidden = false
            -- التحقق من حالة التخفي (إذا كان القاتل لديه قدرة التخفي)
            local character = LocalPlayer.Character
            if character then
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("Part") and child.Name == "Stealth" then
                        isHidden = true
                        break
                    end
                end
            end
            roleL.Text = "💀 " .. alivePlayers .. " متبقي" .. (isHidden and " 👻" or "")
            roleL.TextColor3 = Color3.fromRGB(255, 200, 100)
        else
            roleL.Text = info.Role
            roleL.TextColor3 = col
        end
    end
    
    -- تحديث حجم النافذة
    RoleESP_Frame.Size = UDim2.new(0, 220, 0, 30 + #rows * 34 + 6)
end

